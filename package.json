{
  "name": "wif",
  "version": "2.0.0",
  "description": "GitHub Action to acquire Microsoft Entra ID access tokens via workload identity federation (GitHub OIDC).",
  "type": "module",
  "main": "dist/index.js",
  "exports": "./src/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "ncc build src/index.js -o dist --license licenses.txt",
    "test": "node --test",
    "all": "npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolonsky/WIF.git"
  },
  "keywords": [
    "github-actions",
    "entra-id",
    "azure-ad",
    "oidc",
    "workload-identity-federation",
    "microsoft-graph"
  ],
  "author": "Nicola Suter",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nicolonsky/WIF/issues"
  },
  "homepage": "https://github.com/nicolonsky/WIF#readme",
  "dependencies": {
    "@actions/core": "^3.0.1"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.45.0"
  }
}
